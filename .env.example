# Le serveur ouvre un catalogue déjà généré en lecture seule.
# Utilisez d'abord ./scripts/index_catalog --fake pour cette configuration.
EBOOK_SOURCE=fake
EBOOK_DATA_DIR=./data

# Le lancement local avec start_dev active ces options automatiquement.
# Elles doivent rester désactivées dans l'image Scaleway en lecture seule.
EBOOK_BACKGROUND_INDEX=0
EBOOK_FORCE_INDEX_ON_START=0

# Dossier local en lecture seule ; seuls les fichiers EPUB sont indexés.
# EBOOK_SOURCE=local
# EBOOK_LOCAL_DIR=/chemin/absolu/vers/les/ebooks

# Dossier Google Drive public : un seul lien, aucun compte Google nécessaire.
# EBOOK_SOURCE=google_public
# GOOGLE_DRIVE_PUBLIC_URL=https://drive.google.com/drive/folders/identifiant_du_dossier

# Pour utiliser l'API Google Drive avec un compte de service :
# EBOOK_SOURCE=google
# GOOGLE_SERVICE_ACCOUNT_FILE=/chemin/absolu/vers/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=identifiant_du_dossier_partage
# GOOGLE_DRIVE_ID=identifiant_du_drive_partage

# Limites de sécurité, en octets / nombre d'entrées.
EBOOK_MAX_FILE_SIZE=157286400
EBOOK_MAX_EPUB_EXPANDED_SIZE=314572800
EBOOK_MAX_EPUB_ENTRIES=10000
