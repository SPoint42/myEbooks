#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
VENV_DIR="${PROJECT_DIR}/.venv"
PYTHON="${VENV_DIR}/bin/python"
INSTALL_STAMP="${VENV_DIR}/.myebooks-dev-installed"

if [[ ! -x "$PYTHON" ]]; then
    if command -v python3 >/dev/null 2>&1 \
        && python3 -c "import ebooklib, fastapi, gdown, myebooks, pymupdf" >/dev/null 2>&1; then
        PYTHON=python3
    else
        if ! command -v python3 >/dev/null 2>&1; then
            echo "Erreur : Python 3 est introuvable." >&2
            exit 1
        fi
        echo "Création de l'environnement Python dans ${VENV_DIR}…"
        python3 -m venv "$VENV_DIR"
        PYTHON="${VENV_DIR}/bin/python"
    fi
fi

if [[ "$PYTHON" == "${VENV_DIR}/bin/python" ]]; then
    needs_install=0
    if ! "$PYTHON" -c "import ebooklib, fastapi, gdown, myebooks, pymupdf" \
        >/dev/null 2>&1; then
        needs_install=1
    fi
    if [[ "$needs_install" == "1" ]]; then
        echo "Installation des dépendances de myEbooks…"
        "$PYTHON" -m pip install --disable-pip-version-check -e "${PROJECT_DIR}[dev]"
        touch "$INSTALL_STAMP"
    fi
fi

cd "$PROJECT_DIR"
exec "$PYTHON" -m myebooks.catalog_cli "$@"
